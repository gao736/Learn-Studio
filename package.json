{
  "name": "learning-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "start:hosted": "next start --hostname 0.0.0.0",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file=.env.local scripts/migrate.ts",
    "mail:local": "node --env-file=.env.local scripts/local-mail.ts",
    "worker": "node --env-file=.env.local scripts/worker.ts"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "next": "16.3.8",
    "nodemailer": "10.0.14",
    "pg": "8.16.3",
    "pg-boss": "12.37.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.0",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/smtp-server": "3.5.12",
    "smtp-server": "3.19.17",
    "typescript": "5.9.3"
  }
}
