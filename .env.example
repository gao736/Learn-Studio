DATABASE_URL=postgresql://learning_app:CHANGE_ME@127.0.0.1:54329/learning_platform
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=http://127.0.0.1:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Learning Studio <noreply@example.test>
SMTP_USER=
SMTP_PASSWORD=
# Local test mail is not internet email delivery. Never enable it on a public deployment.
LOCAL_MAILBOX=true
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# Only this verified free text model is allowed. Never automatically switch to a paid model.
SILICONFLOW_MODEL=Qwen/Qwen3.5-4B
# Defaults / maximum allowed budgets in fen (100 fen = 1 CNY).
MODEL_MONTHLY_BUDGET_FEN=35000
MODEL_DAILY_BUDGET_FEN=1000
